{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "local": "vite --port=7375 --host=0.0.0.0",
    "build": "node fix-ico.cjs && vite build && node -e \"const fs = require('fs'); fs.mkdirSync('dist', { recursive: true }); fs.copyFileSync('src/assets/images/arka_logo.png', 'dist/arka_logo.png'); fs.copyFileSync('src/assets/images/arka_logo.ico', 'dist/arka_logo.ico');\"",
    "tauri": "npx @tauri-apps/cli",
    "tauri:icon": "npx @tauri-apps/cli icon src/assets/images/arka_logo.png",
    "tauri:dev": "npx @tauri-apps/cli dev",
    "tauri:build": "npm run build && npx @tauri-apps/cli build",
    "build:win": "npm run build && npx @tauri-apps/cli build",
    "package-win": "npm run build && npm run obfuscate && electron-builder --win",
    "package:server-win": "npm run build && node package-server-windows.cjs",
    "build:server-win": "node package-server-windows.cjs",
    "obfuscate": "javascript-obfuscator dist/assets --output dist/assets --compact true --self-defending true --string-array true --string-array-encoding base64 --string-array-threshold 0.8",
    "preview": "vite preview",
    "preview-local": "vite preview --port=7375 --host=0.0.0.0",
    "clean": "rm -rf dist server.js dist-windows-server",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-multi-date-picker": "^4.5.2",
    "react-to-print": "^3.3.0",
    "vazirmatn": "^33.0.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "javascript-obfuscator": "^5.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^2.0.0"
  },
  "build": {
    "appId": "com.arkasystem.pos",
    "productName": "Arka System",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "src/assets/images/arka_logo.ico"
    }
  }
}
